{
  "id": "file_organizer_v1",
  "version": 1,
  "name": "File Organizer",
  "category": "file_management.organization",
  "description": "Organizes files in a directory by type/extension into category subdirectories.",
  "workflow": {
    "workers": [
      {
        "role": "file_scanner",
        "description": "List and read metadata for all files in the target directory",
        "tools": ["fs.list_directory", "fs.get_metadata"],
        "permission_mode": "read_only",
        "max_runtime_seconds": 30
      },
      {
        "role": "file_classifier",
        "description": "Classify files into categories based on extension and metadata",
        "tools": ["fs.get_metadata"],
        "permission_mode": "read_only",
        "max_runtime_seconds": 60,
        "uses_inference": true,
        "inference_task_type": "classify"
      },
      {
        "role": "file_organizer",
        "description": "Create category directories and move files into them",
        "tools": ["fs.create_directory", "fs.move_file"],
        "permission_mode": "read_write",
        "max_runtime_seconds": 120
      }
    ],
    "execution_mode": "sequential",
    "rollback_strategy": "log_and_reverse",
    "categories": {
      "Images": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".svg", ".webp", ".heic", ".raw"],
      "Documents": [".pdf", ".doc", ".docx", ".txt", ".md", ".odt", ".rtf", ".xls", ".xlsx", ".ppt", ".pptx", ".csv"],
      "Videos": [".mp4", ".mov", ".avi", ".mkv", ".wmv", ".flv", ".webm", ".m4v"],
      "Audio": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".wma", ".m4a"],
      "Archives": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2", ".xz"],
      "Code": [".py", ".js", ".ts", ".html", ".css", ".java", ".cpp", ".c", ".go", ".rs", ".json", ".yaml", ".toml"],
      "Other": []
    }
  },
  "requirements": {
    "min_free_disk_mb": 100,
    "supports_dry_run": true
  }
}
